{
  "name": "JICA Pulse Dark",
  "source": "MetroTel Pulse dark template",
  "dashboardTheme": "Dark",
  "colors": {
    "background": "#070B14",
    "panel": "#121B2C",
    "panelAlt": "#0C1320",
    "border": "#1E2A40",
    "text": "#E8EEF7",
    "muted": "#8B9BB4",
    "irrigation": "#2EE6D6",
    "watershed": "#F5C15A",
    "awarded": "#3DDC97",
    "notAwarded": "#FF5C7A",
    "accent": "#5B8CFF",
    "progress": "#3DDC97"
  },
  "map": {
    "basemap": "Human Geography Dark Map or Dark Gray Canvas",
    "areaFillOpacity": 0.30,
    "lineWidthMetersHint": "thicker than default so canals read on dark basemap"
  },
  "fieldMap": {
    "Scheme_UID": "UNID",
    "Pair_ID": "Site_Number",
    "STATUS": "Awarding_Status",
    "PROGRESS_PCT": "Physical_Progress_Percentage",
    "COST_USD": "Contract_Cost_USD",
    "AREA_HA": "Intervention_Area (Ha)",
    "HOUSEHOLDS": "Households",
    "CANAL_KM": "Canal_Length_Km",
    "CONTRACTOR": "Construction_Company"
  },
  "kpis": {
    "Schemes": { "color": "#E8EEF7", "statistic": "count", "field": "Scheme_UID", "filter": null },
    "Awarded": { "color": "#3DDC97", "statistic": "count", "field": "Scheme_UID", "filter": "STATUS = Awarded" },
    "Physical works": {
      "color": "#3DDC97",
      "statistic": "average",
      "field": "PROGRESS_PCT",
      "filter": "STATUS = Awarded",
      "suffix": "%",
      "meaning": "Percent of physical works completed on each awarded project. KPI averages those projects in the current filter. Site selector scopes to that Pair_ID."
    },
    "Awarded cost": { "color": "#F5C15A", "statistic": "sum", "field": "COST_USD", "filter": "STATUS = Awarded" },
    "Area": { "color": "#2EE6D6", "statistic": "sum", "field": "AREA_HA", "filter": null },
    "Households": { "color": "#5B8CFF", "statistic": "sum", "field": "HOUSEHOLDS", "filter": "Program = Irrigation" },
    "Canal km": { "color": "#2EE6D6", "statistic": "sum", "field": "CANAL_KM", "filter": "Program = Irrigation" }
  },
